#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    /* Definisi Matrix Scanning GPIO (4 Rows x 4 Cols) */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "COL2ROW"; // Arah dioda standar Dumbpad

        row-gpios
            = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 0 (D4)
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 1 (C6)
            , <&gpio1  0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 2 (D7)
            , <&gpio1  4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 3 (E6)
            ;

        col-gpios
            = <&gpio0  2 GPIO_ACTIVE_HIGH> // Col 0 (F4)
            , <&gpio0 29 GPIO_ACTIVE_HIGH> // Col 1 (F5)
            , <&gpio0 31 GPIO_ACTIVE_HIGH> // Col 2 (F6)
            , <&gpio0 22 GPIO_ACTIVE_HIGH> // Col 3 (F7)
            ;
    };

    /* Matrix Transform untuk memetakan tombol di ZMK Keymap */
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <4>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3)
        >;
    };

    /* Definisi Hardware Rotary Encoder (Sisi Kiri Kiri-Bawah / Posisi X) */
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  // Pin A (B2)
        b-gpios = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;  // Pin B (B6)
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };
};
